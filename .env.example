POSTGRES_DB=commerce
POSTGRES_USER=commerce
POSTGRES_PASSWORD=commerce_local
POSTGRES_PORT=55432
REDIS_PORT=56379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=commerce
RABBITMQ_PASSWORD=commerce_local
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=commerce
MINIO_ROOT_PASSWORD=commerce_local_secret
COMMERCE_API_PORT=8080
NEXT_PUBLIC_COMMERCE_API_URL=http://127.0.0.1:8080
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000
VITE_COMMERCE_API_URL=http://localhost:8080
# Local seller-center preview only. Production reads merchant_id from the signed access token.
VITE_SELLER_MERCHANT_ID=20000000-0000-0000-0000-000000000001
AI_SERVICE_PORT=8000
OIDC_ISSUER_URI=http://localhost:8081/realms/commerce
AI_PROVIDER=deepseek
AI_MODEL=deepseek-flash
AI_MODEL_BASE_URL=https://api.deepseek.com
AI_MODEL_TIMEOUT_SECONDS=20
# 客服回答以证据为主，默认关闭 deepseek-flash 思考模式，避免推理 token 挤占商品推荐等长答案。
AI_THINKING=false
DEEPSEEK_API_KEY=replace_with_rotated_secret
# 本机 MLX + LoRA 试训模式：先按 README 启动 mlx_lm.server，再取消下面三行注释。
# AI_PROVIDER=mlx
# AI_MODEL=data/models/Qwen3-4B-Instruct-2507-4bit
# AI_MODEL_BASE_URL=http://127.0.0.1:18080/v1
OIDC_JWK_SET_URI=http://localhost:8081/realms/commerce/protocol/openid-connect/certs
PUBLIC_COMMERCE_API_URL=http://localhost:8080
PUBLIC_AI_SERVICE_URL=http://localhost:8000
COMMERCE_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
PAYMENT_WEBHOOK_SECRET=replace_with_at_least_32_random_characters
AI_TRUSTED_CONTEXT_SECRET=replace_with_at_least_32_random_characters
# AI 服务调用 NOVA 库存/订单/物流/支付只读工具；两项必须配置为同一个独立强密钥。
AI_COMMERCE_TOOL_SECRET=replace_with_a_different_32_char_secret
# Independent server-to-server keys; use a distinct random value per application.
AI_OMS_INTEGRATION_SECRET=
AI_BUZUD_INTEGRATION_SECRET=
# Independent read-only support agents. Enable per deployment after validating its provider.
AI_INTEGRATION_AGENTS_ENABLED=false
AI_AGENT_TOTAL_TIMEOUT_SECONDS=24
AI_AGENT_CALL_TIMEOUT_SECONDS=6
AI_AGENT_MAX_CALLS=11
COMMERCE_SUPPORT_TOOL_SECRET=replace_with_a_different_32_char_secret
AI_COMMERCE_TOOL_TIMEOUT_SECONDS=3
AI_SERVICE_URL=http://127.0.0.1:8000
# Development only: requires SPRING_PROFILES_ACTIVE=local. Never enable in production.
LOCAL_ADMIN_PUBLIC=false
BRIGHT_DATA_API_KEY=replace_with_bright_data_api_key
BRIGHT_DATA_LAZADA_DATASET_ID=gd_m6gjtfmeh43we6cqc

# 知识检索：auto = 向量 + 关键词融合，keyword = 仅关键词
AI_RETRIEVER=auto
AI_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 持久缓存；不要使用系统临时目录，否则重启后会退化为关键词检索
AI_EMBEDDING_CACHE_DIR=~/.cache/nova/fastembed
AI_EMBEDDING_LOCAL_ONLY=true
AI_EMBEDDING_MIN_SCORE=0.45
# 可选：额外知识条目（JSONL）
AI_KNOWLEDGE_FILE=

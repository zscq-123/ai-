{
  "name": "support-suite",
  "services": {
    "oms-gateway": {
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "2"
        }
      },
      "networks": [
        "default"
      ],
      "image": "eclipse-temurin:25-jre",
      "user": "10001:10001",
      "working_dir": "/app",
      "command": [
        "java",
        "-jar",
        "/app/service.jar"
      ],
      "volumes": [
        "./jars/oms-gateway.jar:/app/service.jar:ro"
      ],
      "env_file": [
        "/opt/support-suite/shared/oms.env"
      ],
      "environment": {
        "JAVA_TOOL_OPTIONS": "-Xms32m -Xmx112m -XX:MaxMetaspaceSize=128m -XX:ReservedCodeCacheSize=24m -XX:MaxDirectMemorySize=16m -Xss512k -XX:+UseSerialGC -XX:ActiveProcessorCount=1 -Duser.home=/tmp -Dcsp.sentinel.log.dir=/tmp/sentinel",
        "SERVER_PORT": "8080",
        "SPRING_PROFILES_ACTIVE": "server",
        "SPRING_CONFIG_IMPORT": "optional:file:/app/none.properties",
        "SPRING_CLOUD_NACOS_DISCOVERY_ENABLED": "false",
        "SPRING_CLOUD_NACOS_CONFIG_ENABLED": "false",
        "SPRING_CLOUD_NACOS_CONFIG_IMPORT_CHECK_ENABLED": "false",
        "SPRING_CLOUD_SENTINEL_ENABLED": "false",
        "SPRING_CLOUD_GATEWAY_SERVER_WEBFLUX_DISCOVERY_LOCATOR_ENABLED": "false",
        "SPRING_APPLICATION_JSON": "{\"spring\":{\"cloud\":{\"discovery\":{\"client\":{\"simple\":{\"instances\":{\"user-service\":[{\"uri\":\"http://user-service:8081\"}],\"order-service\":[{\"uri\":\"http://order-service:8082\"}],\"inventory-service\":[{\"uri\":\"http://inventory-service:8083\"}],\"after-sales-service\":[{\"uri\":\"http://after-sales-service:8084\"}],\"payment-center\":[{\"uri\":\"http://payment-center:8085\"}],\"integration-service\":[{\"uri\":\"http://integration-service:8086\"}]}}}}}}}",
        "SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE": "3",
        "SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE": "1",
        "SERVER_TOMCAT_THREADS_MAX": "16",
        "SERVER_TOMCAT_THREADS_MIN_SPARE": "2",
        "MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE": "health,info",
        "MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS": "never",
        "SPRINGDOC_API_DOCS_ENABLED": "false",
        "SPRINGDOC_SWAGGER_UI_ENABLED": "false",
        "MYSQL_HOST": "support-mysql",
        "MYSQL_USERNAME": "support_oms",
        "REDIS_HOST": "support-redis",
        "OMS_SEED_DEMO_DATA": "false",
        "OMS_SENTINEL_ENABLED": "false",
        "OMS_INVENTORY_URL": "http://inventory-service:8083",
        "OMS_PAYMENT_URL": "http://payment-center:8085",
        "OMS_ORDER_URL": "http://order-service:8082",
